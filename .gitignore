# Dependency directories
node_modules/
jspm_packages/
web_modules/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented code coverage (e.g. nyc/istanbul)
coverage/
.nyc_output/

# Local env files - NEVER commit sensitive credentials to git!
# Note: Keep .env.example tracked in git as a template, but ignore actual .env files.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# OS files
.DS_Store
Thumbs.db

# IDEs and editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
